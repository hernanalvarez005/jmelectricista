# Supabase project URL and anonymous (public) key.
# Find these in your Supabase project: Project Settings -> API.
# The anon key is safe to expose to the browser; it relies on Row Level
# Security (RLS) policies to restrict access. Never put the service_role
# key in a NEXT_PUBLIC_ variable or ship it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL pública de la app (sin barra final). Se usa para armar los enlaces que salen del sistema, como el
# de una cotización compartida por WhatsApp (https://tu-dominio/cotizacion/<token>). Si no se define, se
# deduce del request (host + protocolo). Ejemplo: https://app.tu-dominio.com
NEXT_PUBLIC_APP_URL=
